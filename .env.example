DEVTEAM_ENV=development
DEVTEAM_DATABASE_URL=sqlite:///./data/devteam_agent.db
DEVTEAM_LOG_LEVEL=INFO
DEVTEAM_LOG_JSON=false
DEVTEAM_AGENT_MAX_STEPS=40
DEVTEAM_AGENT_MAX_LLM_CALLS=15
DEVTEAM_AGENT_MAX_TOOL_CALLS=30
DEVTEAM_AGENT_MAX_REPAIR_ROUNDS=3
DEVTEAM_AGENT_MAX_CHANGED_FILES=10
DEVTEAM_AGENT_MAX_TOKENS=200000
DEVTEAM_AGENT_TIMEOUT_SECONDS=600
DEVTEAM_AGENT_CONTEXT_MAX_TOKENS=32000
DEVTEAM_AGENT_REPEATED_ACTION_LIMIT=3
DEVTEAM_AGENT_MODEL_STRONG_CONTEXT_TOKENS=24000
DEVTEAM_SKILL_ROOT=./skills
DEVTEAM_GIT_EXECUTABLE=git
DEVTEAM_TERMINAL_EXECUTOR=local
DEVTEAM_DOCKER_EXECUTABLE=docker
DEVTEAM_NODE_EXECUTABLE=node
DEVTEAM_WORKER_CONCURRENCY=1
DEVTEAM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEVTEAM_DATABASE_AUTO_CREATE=true
# MCP 仅允许访问这些目录及其子目录。使用英文逗号分隔；未配置时 MCP 拒绝启动。
DEVTEAM_MCP_ALLOWED_WORKSPACE_ROOTS=
# 代码检索：默认 hash provider 是离线确定性基线；要获得真正语义检索，
# 配置 openai provider 以及任意兼容 /embeddings 的服务。
DEVTEAM_RETRIEVAL_MODE=hybrid
DEVTEAM_RETRIEVAL_BM25_TOP_K=20
DEVTEAM_RETRIEVAL_DENSE_TOP_K=20
DEVTEAM_RETRIEVAL_FINAL_TOP_K=8
DEVTEAM_RETRIEVAL_RRF_K=60
DEVTEAM_RETRIEVAL_MAX_MERGED_CHARS=16000
DEVTEAM_RETRIEVAL_TIMEOUT_SECONDS=30
DEVTEAM_RETRIEVAL_DEFAULT_LANGUAGES=
DEVTEAM_RETRIEVAL_DEFAULT_SYMBOL_TYPES=
DEVTEAM_EMBEDDING_PROVIDER=hash
DEVTEAM_EMBEDDING_MODEL=text-embedding-3-small
DEVTEAM_EMBEDDING_DIMENSION=256
DEVTEAM_EMBEDDING_BATCH_SIZE=32
DEVTEAM_EMBEDDING_API_KEY=
DEVTEAM_EMBEDDING_BASE_URL=
DEVTEAM_LLM_PROVIDER=demo
DEVTEAM_LLM_MODEL=gpt-5.6-sol
# 正常使用 DYNAMIC；FIXED_* 仅用于同一评测集的对照实验。
DEVTEAM_MODEL_ROUTING_STRATEGY=DYNAMIC
# 三档模型未填写时自动回退到 DEVTEAM_LLM_MODEL，兼容原有配置。
DEVTEAM_LLM_LIGHT_MODEL=
DEVTEAM_LLM_STANDARD_MODEL=
DEVTEAM_LLM_STRONG_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
DEVTEAM_OPENAI_TIMEOUT_SECONDS=120
DEVTEAM_OPENAI_MAX_RETRIES=2
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_PROXY_URL=
DEVTEAM_DEEPSEEK_THINKING_ENABLED=false
DEVTEAM_DEEPSEEK_MAX_OUTPUT_TOKENS=16384
# 分档参数留空时自动采用：轻量档不超过 4096、标准档不超过 8192、强档使用全局上限。
# 分档参数留空时继承上方全局 DeepSeek 参数。
DEVTEAM_DEEPSEEK_LIGHT_THINKING_ENABLED=
DEVTEAM_DEEPSEEK_STANDARD_THINKING_ENABLED=
DEVTEAM_DEEPSEEK_STRONG_THINKING_ENABLED=
DEVTEAM_DEEPSEEK_LIGHT_MAX_OUTPUT_TOKENS=
DEVTEAM_DEEPSEEK_STANDARD_MAX_OUTPUT_TOKENS=
DEVTEAM_DEEPSEEK_STRONG_MAX_OUTPUT_TOKENS=
DEVTEAM_DEEPSEEK_TIMEOUT_SECONDS=180
DEVTEAM_DEEPSEEK_MAX_RETRIES=2
